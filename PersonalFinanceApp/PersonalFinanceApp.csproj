<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
		<!-- Product/AssemblyTitle belirtilmediğinde MSBuild exe'nin sürüm bilgisine varsayılan
		     olarak proje adını ("PersonalFinanceApp") yazıyordu — Windows bildirim/eylem merkezi
		     ve görev çubuğu bunu ikonun yanında uygulama adı olarak gösteriyordu. -->
		<Product>Finans Takip</Product>
		<AssemblyTitle>Finans Takip</AssemblyTitle>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql" Version="9.0.2" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="config.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>